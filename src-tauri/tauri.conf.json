{
  "package": {
    "productName": "liaoyitong-print-bridge",
    "version": "0.1.2"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.liaoyitong.printbridge",
      "resources": [
        "resources/print-bridge.example.json",
        "resources/sumatra/README.txt"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "scope": [
          "**"
        ]
      },
      "path": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "windows": [
        {
          "label": "main",
          "url": "status.html",
          "title": "辽易通打印桥 v0.1.2",
        "width": 360,
        "height": 220,
        "minWidth": 360,
        "minHeight": 220,
        "resizable": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    }
  }
}
